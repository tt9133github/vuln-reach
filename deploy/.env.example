# Platform images. Replace OCTOBUS_IMAGE with the verified RepoDigest after the first pull.
AGENT_COMPOSE_IMAGE=ghcr.io/chaitin/agent-compose:v2607.10.0
DEFAULT_IMAGE=ghcr.io/chaitin/agent-compose-guest:v2607.10.0
OCTOBUS_IMAGE=ghcr.io/chaitin/octobus:latest

AGENT_COMPOSE_DATA_DIR=/opt/agent-compose/data
HTTP_LISTEN=0.0.0.0:7410
DATA_ROOT=/data
RUNTIME_DRIVER=docker
TZ=Asia/Shanghai

# OpenAI-compatible upstream used by the Agent Compose LLM facade.
LLM_API_ENDPOINT=
LLM_API_PROTOCOL=chat_completions
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_MAX_OUTPUT_TOKENS=32768
LLM_TIMEOUT=120s

# Generate with: openssl rand -hex 32
OCTOBUS_TOKEN=
